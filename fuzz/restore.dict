# Pieces of the control codes and text that the terminal handles, so that the
# fuzzer does not have to find each of them one byte at a time.

# C0 controls and ESC sequences
"\x0d\x0a"
"\x1b7"
"\x1b8"
"\x1bD"
"\x1bE"
"\x1bH"
"\x1bM"
"\x1bN"
"\x1bO"
"\x1bc"
"\x1bn"
"\x1bo"
"\x1b="
"\x1b>"
"\x1b#8"
"\x1b(0"
"\x1b)0"
"\x1b*0"
"\x1b+0"
"\x1b(A"
"\x1b(B"
"\x1b\\"

# CSI, with its private markers and intermediates
"\x1b["
"\x1b[?"
"\x1b[>"
"\x1b[<"
"\x1b[="
"!p"
" q"
"$p"
"\x22q"

# DEC private modes
"1049"
"1047"
"1048"
"1000"
"1002"
"1003"
"1004"
"1005"
"1006"
"1007"
"1015"
"1016"
"1034"
"2004"
"2026"
"25"
"45"
"47"
"66"
"69"

# SGR
"38;5;"
"48;5;"
"58;5;"
"38;2;"
"48;2;"
"58:2::"
"4:3"

# OSC
"\x1b]"
"\x1b]0;"
"\x1b]2;"
"\x1b]4;"
"rgb:"
"\x1b]7;file://"
"\x1b]8;;"
"\x1b]10;"
"\x1b]11;"
"\x1b]12;"
"\x1b]22;"
"\x1b]23;"
"\x1b]52;c;"
"\x1b]104"
"\x1b]110"

# DCS
"\x1bP"
"\x1bP$q"

# Wide chars, combining marks and emoji modifiers
"\xe4\xb8\xad"
"\xf0\x9f\x98\x8a"
"\xc3\xa9"
"\xcc\x81"
"\xe2\x80\x8d"
"\xef\xb8\x8f"
